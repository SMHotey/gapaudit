.venv/
__pycache__/
*.pyc
*.pyo
.idea/
# Рабочая папка dev-режима: база, кэш, логи задач, скриншоты проверок.
# Исключение — пустой .gitkeep, чтобы папка осталась в репозитории.
# docs/ не игнорируется: скриншоты-артефакты шагов лежат там.
data/*
!data/.gitkeep
*.log
dist/
build/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ключи внешних API (настраиваются в приложении, лежат в <data_dir>)
api_keys.json
data/api_keys.json
